# Cloudflare headers (Workers static assets; GitHub Pages ignores this file)
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/ether/ether.min.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/ether/ether.min.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/visual/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
